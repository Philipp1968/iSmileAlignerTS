@model iSmileAlignerTS.Models.IndexViewModel

@{
    ViewBag.Title = "Verwalten";
}

<h2>@ViewBag.Title</h2>
<p> &nbsp; </p>

<p class="text-success">@ViewBag.StatusMessage</p>

<div>
    <dl class="dl-horizontal">
        <dt>Kennwort:</dt>
        <dd>
            @if (Model.HasPassword)
            {
                @Html.ActionLink("Kennwort ändern", "ChangePassword", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>
            }
            else
            {
                @Html.ActionLink("Erstellen", "SetPassword", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>
            }
        </dd>
        <dt>Benutzerdaten:</dt>
        <dd>
            @if (Model.HasPassword)
            {
                @Html.ActionLink("Daten ändern", "ChangeUserData", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>
            }
        </dd>
        @if (Model.NeedVerify)
        {
            <dt>Funktionen:</dt>
            <dd>
                Sie müssen erst nach Neuanlage oder Datenänderung freigeschaltet werden. Das erfolgt in Kürze.
            </dd>
        }
        else
        {
            if (Model.CanCreateCase)
            {
                <dt>Funktionen:</dt>
                <dd>
                    @Html.ActionLink("Fall Übersicht", "Index", "Case", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>

                    @Html.ActionLink("Neuen Fall erfassen", "AddNewCase", "Case", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>
                </dd>
            }
            if (Model.CanPurchase)
            {
                <dt>Funktionen:</dt>
                <dd>
                    @Html.ActionLink("Warenkorb", "PayCaseCart", "Payment", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>
                </dd>
                if (Model.CanViewCases)
                {
                    <dd>
                        @Html.ActionLink("Eigene Behandlung(en)", "PatIndex", "Case", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>
                    </dd>
                }
            }
        }
        @if (Model.CanVerifyUser)
        {
            <dt>Adminbereich:</dt>
            <dd>
                @Html.ActionLink("Arzt freischalten", "VerifyUserData", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>

                @Html.ActionLink("Nachrichten beantworten", "CheckUserMessages", "Case", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>

                @Html.ActionLink("Benutzer Kennwort setzen", "SetUserPassword", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>

                @Html.ActionLink("Benutzer löschen", "DeleteUser", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>

                @Html.ActionLink("Benutzer Fall Zuordnung", "SetUserCase", null, new { @class = "btn btn-primary", @style = "background-color:#ca0d89" }) <br /> <p> &nbsp; </p>
            </dd>
        }
    </dl>
</div>
