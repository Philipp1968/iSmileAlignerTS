@using iSmileAlignerTS.Models

@model IEnumerable<iSmileAlignerTS.Models.SetUserPasswordViewModel>

@{
    ViewBag.Title = "Kennwort zurücksetzen";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("SetUserPassword", "Manage", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <div class="row">
            @Html.Label("Konto", new { @class = "col-md-3" })
            @Html.Label("Person", new { @class = "col-md-3" })
            @Html.Label("Kennwort", new { @class = "col-md-3" })
            @Html.Label("Ändern", new { @class = "col-md-3" })
        </div>

        @foreach (var itemElement in Model)
        {
            <div class="row">
                <div class="col-md-3">
                    @Html.DisplayFor(item => itemElement.Email)
                </div>

                <div class="col-md-3">
                    @Html.DisplayFor(item => itemElement.Firstname) &nbsp; @Html.DisplayFor(item => itemElement.Lastname)
                </div>

                <div class="col-md-3">
                    @Html.TextBox("pw" + @itemElement.UserID, "")
                </div>

                <div class="col-md-1">
                    <button type="submit" name="setPasswordButton" value="@itemElement.UserID" class="btn">Setzen</button>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-md-10">
                <p>Die Kennwortkomplexität erfordert mindestens 8 Zeichen, mindestens ein Kleinbuchstabe, mindestens ein Großbuchstabe, 
                mindestens eine Ziffer, und mindestens ein Sonderzeichen, wie ein Punkt, Rufzeichen, oder ähnlich.</p>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}