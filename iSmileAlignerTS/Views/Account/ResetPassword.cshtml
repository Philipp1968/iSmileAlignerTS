@model iSmileAlignerTS.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Kennwort zurücksetzen";
}

<h2>@ViewBag.Title</h2>
<p> &nbsp; </p>

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()
    <h4>Kennwort zurücksetzen.</h4>
    <hr />
    @Html.ValidationSummary("", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Code)
    <div class="form-group">
        <div class="row">
            @Html.LabelFor(m => m.Email, new { @class = "col-md-2 control-label" })
            <div class="col-md-2">
                @Html.EditorFor(m => m.Email, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            @Html.LabelFor(m => m.Password, new { @class = "col-md-2 control-label" })
            <div class="col-md-2">
                @Html.EditorFor(m => m.Password, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-2 control-label" })
            <div class="col-md-2">
                @Html.EditorFor(m => m.ConfirmPassword, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            <div class="col-md-10">
                <p>
                    Die Kennwortkomplexität erfordert mindestens 8 Zeichen, mindestens ein Kleinbuchstabe, mindestens ein Großbuchstabe, mindestens eine Ziffer, und mindestens ein Sonderzeichen, wie ein Punkt, Rufzeichen, oder ähnlich.
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" class="btn btn-default" value="Zurücksetzen" />
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
