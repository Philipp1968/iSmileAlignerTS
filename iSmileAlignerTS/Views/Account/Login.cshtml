@using iSmileAlignerTS.Models
@model LoginViewModel
@{
    ViewBag.Title = "Anmelden";
}

<h2>@ViewBag.Title</h2>
<p> &nbsp; </p>

<div class="row">
    <div class="col-md-8">
        <section id="loginForm">
            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                if (ViewBag.ValidationErrors != null)
                {
                    <div class="form-group">
                        <div class="row">
                            @Html.Label("Eingabeproblem", new { @class = "col-md-2 control-label" })
                            <div class="col-md-8">
                                <p>
                                    <b>
                                        <font color="red">
                                            @ViewBag.ValidationErrors
                                        </font>
                                    </b>
                                </p>
                            </div>
                        </div>
                    </div>
                }
                <div class="form-group">
                    <div class="row">
                        @Html.LabelFor(m => m.Email, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.EditorFor(m => m.Email, new { @class = "col-md-4" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        @Html.LabelFor(m => m.Password, new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.EditorFor(m => m.Password, new { @class = "col-md-4" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-offset-2 col-md-10">
                            <div class="checkbox">
                                @Html.CheckBoxFor(m => m.RememberMe)
                                @Html.LabelFor(m => m.RememberMe)
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-offset-2 col-md-6">
                            <input type="submit" value="Anmelden" class="btn btn-default" />
                        </div>
                    </div>
                </div>
                @* Diese Option aktivieren, nachdem Sie die Kontobestätigung für die Funktion zum Zurücksetzen des Kennworts aktiviert haben
                    <p>
                        @Html.ActionLink("Kennwort vergessen?", "ForgotPassword")
                    </p>*@
            }
        </section>
    </div>

    @*
        <div class="col-md-4">
            <section id="socialLoginForm">
                @Html.Partial("_ExternalLoginsListPartial", new ExternalLoginListViewModel { ReturnUrl = ViewBag.ReturnUrl })
            </section>
        </div>
    *@

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}