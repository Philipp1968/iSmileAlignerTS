@model iSmileAlignerTS.Models.Wares

@{
    ViewBag.Title = "Details";
}

<h2>@ViewBag.Title</h2>

<div>
    <h4>Waren</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.Display("Nummer")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.WareNumber)
        </dd>

        <dt>
            @Html.Display("Beschreibung")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Longtext)
        </dd>

        <dt>
            @Html.Display("Zusatz")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.AddInfoText)
        </dd>

        <dt>
            @Html.Display("Preis/Doc")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.PriceDoc)
        </dd>

        <dt>
            @Html.Display("Preis/Pat")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.PricePat)
        </dd>

        <dt>
            @Html.Display("Währung")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Currency)
        </dd>

        <dt>
            @Html.Display("Steuer")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Tax)
        </dd>

        <dt>
            @Html.Display("Anfrage")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.isRequestQuote)
        </dd>

        <dt>
            @Html.Display("Shop")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.InShop)
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Zurück zur Übersicht", "Index")
</p>
