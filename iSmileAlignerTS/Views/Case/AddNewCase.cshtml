@model iSmileAlignerTS.Models.CaseViewModel

@{
    ViewBag.Title = "Neuer Fall anlegen";
}

<h2>@ViewBag.Title</h2>
<p> &nbsp; </p>

@using (Html.BeginForm("AddNewCase", "Case", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.CaseId);
    @Html.HiddenFor(m => m.RowVersion);

    @Html.ValidationSummary("", new { @class = "text-danger" })
    
    if (ViewBag.ValidationErrors != null)
    {
        <div class="form-group">
            <div class="row">
                @Html.Label("Eingabeproblem", new { @class = "col-md-2 control-label" })
                <div class="col-md-8">
                    <p>
                        <b>
                            <font color="red">
                                @ViewBag.ValidationErrors
                            </font>
                        </b>
                    </p>
                </div>
            </div>
        </div>
    }

    @Html.Partial("_Patient")

    @Html.Partial("_Oberkiefer")
    
    @Html.Partial("_Unterkiefer")

    @Html.Partial("_Zusatzbehandlungen")

    @Html.Partial("_Bilder")

    @Html.Partial("_SonstigeBilder")

    <div class="form-group">
        @Html.Label("Begleittext", new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextAreaFor(m => m.CurrentMessage, new { @cols = 60, @rows = 4, htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Accepted, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.CheckBoxFor(m => m.Accepted, new { style = "width:24px;height:24px" }) &nbsp; Ich akzeptiere die allgemeinen Geschäftsbedingungen von iSmile und ts-dent esthetic dental technology
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-2">
            <input type="submit" name="submitButton" class="btn btn-primary" value="Fall anlegen" style="background-color: #ca0d89"/>
        </div>
    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}