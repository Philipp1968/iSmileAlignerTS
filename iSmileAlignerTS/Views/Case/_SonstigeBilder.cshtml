@model iSmileAlignerTS.Models.CaseViewModel

<div class="form-group">
    <div class="row">
        @Html.Label("Animation:", new { @class = "col-md-2 control-label" })
    </div>
    <div class="row">
        <div class="col-md-4">
            @if (Model.FrontAnimationGifID > 0)
            {
                <a href="@Url.Action("OpenPicture", "Case", new { id = Model.FrontAnimationGifID })" target="_blank">
                    <img src="@Url.Action("OpenPicture", "Case", new { id = Model.FrontAnimationGifID })" title="@Model.FrontAnimationGifFilename" width="220" />
                </a>
            }
            else
            {
                <br />
            }
            @Html.TextBoxFor(m => m.FrontAnimationGifBin, new { type = "file" })
            @Html.ValidationMessageFor(m => m.FrontAnimationGifBin, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            @if (Model.SideAnimationGifID > 0)
            {
                <a href="@Url.Action("OpenPicture", "Case", new { id = Model.SideAnimationGifID })" target="_blank">
                    <img src="@Url.Action("OpenPicture", "Case", new { id = Model.SideAnimationGifID })" title="@Model.SideAnimationGifFilename" width="220" />
                </a>
            }
            else
            {
                <br />
            }
            @Html.TextBoxFor(m => m.SideAnimationGifBin, new { type = "file" })
            @Html.ValidationMessageFor(m => m.SideAnimationGifBin, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            @if (Model.OcclAnimationGifID > 0)
            {
                <a href="@Url.Action("OpenPicture", "Case", new { id = Model.OcclAnimationGifID })" target="_blank">
                    <img src="@Url.Action("OpenPicture", "Case", new { id = Model.OcclAnimationGifID })" title="@Model.OcclAnimationGifFilename" width="220" />
                </a>
            }
            else
            {
                <img src="~/Images/zahnbewegung.gif" width="220" height="220" />
            }
            @Html.TextBoxFor(m => m.OcclAnimationGifBin, new { type = "file" })
            @Html.ValidationMessageFor(m => m.OcclAnimationGifBin, "", new { @class = "text-danger" })
        </div>
    </div>
</div>

<div class="form-group">
    <div class="row">
        @Html.Label("Röntgen:", new { @class = "col-md-2 control-label" })
    </div>
    <div class="row">
        <div class="col-md-6">
            @if (Model.PanoFotoId != 0 && Model.PanoThumbId != 0)
            {
                <a href="@Url.Action("OpenPicture", "Case", new { id = Model.PanoFotoId  })" target="_blank">
                    <img src="@Url.Action("OpenPicture", "Case", new { id = Model.PanoThumbId})" title="@Model.PanoFotoName" />
                </a>
            }
            else
            {
                @*
                <img src="~/Images/panoroentgensymbol1.png" width="220" title="Pano" />
                *@
                <img src="~/Images/panoblauvoll1.png" width="220" title="Pano" />
            }
            @Html.TextBoxFor(m => m.PanoFotoBin, new { type = "file" })
            @Html.ValidationMessageFor(m => m.PanoFotoBin, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
            @if (Model.DistXFotoId != 0 && Model.DistXThumbId != 0)
            {
                <a href="@Url.Action("OpenPicture", "Case", new { id = Model.DistXFotoId  })" target="_blank">
                    <img src="@Url.Action("OpenPicture", "Case", new { id = Model.DistXThumbId })" title="@Model.DistXFotoName" />
                </a>
            }
            else
            {
                @*
                <img src="~/Images/fernroentgensymbol1.png" width="220" title="Fernröntgen" />
                *@
                <img src="~/Images/fernxrayvoll1.png" width="220" title="Fernröntgen" />
            }
            @Html.TextBoxFor(m => m.DistXFotoBin, new { type = "file" })
            @Html.ValidationMessageFor(m => m.DistXFotoBin, "", new { @class = "text-danger" })
        </div>
    </div>
</div>

@if (Model.Files != null && Model.Files.Count() > 0)
{
    <hr />

    <div class="form-group">
        <div class="row">
            @Html.Label("Bilder:", new { @class = "col-md-2 control-label" })
        </div>
        @{
            var picCount = 1;
            var rowCount = 0;
        }
        @foreach (var item in Model.Files)
        {
            if (rowCount == 0)
            {
                @Html.Raw("<div class=\"row\">")
            }
            
@*
            if (item.FileType == iSmileAlignerTS.Models.CaseFileType.AnyModelOK || item.FileType == iSmileAlignerTS.Models.CaseFileType.AnyModelUK)
            {
                <div class="col-md-3">
                    @Html.Label("Datei (" + picCount.ToString("#0") + ")" + ((item.FileType == iSmileAlignerTS.Models.CaseFileType.AnyModelOK) ? " OK" : " UK")) <br />
                    <canvas name="jsc3dcv" width=240 height=240 urltoload="@Url.Action("OpenPicture", "Case", new { id = @item.ImageId })">
                        Ihr Browser ist leider nicht in der Lage das Model anzuzeigen.
                    </canvas>
                    <br />
                    @item.Filename
                    <br />
                    @item.FileDate.ToString("u")
                </div>
            }
            else
*@

            if (item.FileType == iSmileAlignerTS.Models.CaseFileType.AnyPhoto)
            {
                <div class="col-md-3">
                    @Html.Label("Bild (" + picCount.ToString("#0") + ")") <br />
                    <a href="@Url.Action("OpenPicture", "Case", new { id = item.ImageId  })" target="_blank">
                        <img src="@Url.Action("OpenPicture", "Case", new { id = item.ThumbId })" title="@item.Filename" />
                    </a>
                    <br />
                    @item.Filename
                    <br />
                    @item.FileDate.ToString("u")
                </div>
            }
            else if (item.FileType == iSmileAlignerTS.Models.CaseFileType.PDFFile || item.FileType == iSmileAlignerTS.Models.CaseFileType.PDFRechung || item.FileType == iSmileAlignerTS.Models.CaseFileType.AnyPDFFile)
            {
                <div class="col-md-3">
                    @Html.Label("PDF (" + picCount.ToString("#0") + ")") <br />
                    <a href="@Url.Action("OpenPicture", "Case", new { id = item.ImageId  })" target="_blank">
                        <img src="~/Images/anypdf.png" title="@item.Filename" />
                    </a>
                    <br />
                    @item.Filename
                    <br />
                    @item.FileDate.ToString("u")
                </div>
            }
            else if (item.FileType == iSmileAlignerTS.Models.CaseFileType.AnyModelOK || item.FileType == iSmileAlignerTS.Models.CaseFileType.AnyModelUK)
            {
                <div class="col-md-3">
                    @Html.Label("Modell (" + picCount.ToString("#0") + ")") <br />
                    <a href="@Url.Action("OpenModel", "Case", new { id = item.ImageId  })" target="_blank">
                        <img src="~/Images/anystl.png" title="@item.Filename" />
                    </a>
                    <br />
                    @item.Filename
                    <br />
                    @item.FileDate.ToString("u")
                </div>
            }
            else if (item.FileType == iSmileAlignerTS.Models.CaseFileType.AnyFile)
            {
                <div class="col-md-3">
                    @Html.Label("Datei (" + picCount.ToString("#0") + ")") <br />
                    <a href="@Url.Action("OpenPictureSaveAs", "Case", new { id = item.ImageId })" target="_blank">
                        <img src="~/Images/anyfile.png" title="@item.Filename" />
                    </a>
                    <br />
                    @item.Filename
                    <br />
                    @item.FileDate.ToString("u")
                </div>
            }

            picCount += 1;
            rowCount += 1;

            if (rowCount == 4)
            {
                rowCount = 0;
                @Html.Raw("</div>")
            }
        }
    </div>

    <hr />
}

<div class="form-group">
    @Html.Label("Zusätzliches Bild:", new { @class = "col-md-2 control-label" })
