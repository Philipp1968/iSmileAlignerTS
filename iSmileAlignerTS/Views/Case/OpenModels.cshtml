@model iSmileAlignerTS.Models.CaseViewModel

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="~/favicon.ico" />
    <title>@ViewBag.Title iSmileAligner Partner und Kunden-Webdialog</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        #AnimatediSmile {
            height: 103px;
            width: 103px;
            background: url("~/Images/ismile_animate.gif");
            margin: auto;
        }

            #AnimatediSmile:hover {
                cursor: pointer;
                background: url("~/Images/ismile_animate.gif");
            }
    </style>
</head>
<body>
    <div class="container body-content">
        <div class="row">
            <div class="col-md-6">
                @Html.Label("Model OK Vorher")
            </div>
            <div class="col-md-6">
                @Html.Label("Model OK Nachher/Aktuell")
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @if (Model.ModelBeforeOKSltId != 0)
                {
                    <canvas name="jsc3dcv" width=480 height=480 urltoload="@Url.Action("OpenPicture", "Case", new { id = @Model.ModelBeforeOKSltId.ToString() })">
                        Ihr Browser ist leider nicht in der Lage das Model anzuzeigen.
                    </canvas>
                    <br />
                    if (Model.ModelBeforeOKSltName != null)
                    {
                        @Model.ModelBeforeOKSltName
                    }
                }
                @if (@ViewBag.isAdmin == true)
                {
                    @Html.TextBoxFor(m => m.ModelBeforeOKSltBin, new { type = "file" })
                    @Html.ValidationMessageFor(m => m.ModelBeforeOKSltBin, "", new { @class = "text-danger" })
                }
            </div>
            <div class="col-md-6">
                @if (Model.ModelAfterOKSltId != 0)
                {
                    <canvas name="jsc3dcv" width=480 height=480 urltoload="@Url.Action("OpenPicture", "Case", new { id = @Model.ModelAfterOKSltId })">
                        Ihr Browser ist leider nicht in der Lage das Model anzuzeigen.
                    </canvas>
                    <br />
                    if (Model.ModelAfterOKSltName != null)
                    {
                        @Model.ModelAfterOKSltName
                    }
                }
                @if (@ViewBag.isAdmin == true)
                {
                    @Html.TextBoxFor(m => m.ModelAfterOKSltBin, new { type = "file" })
                    @Html.ValidationMessageFor(m => m.ModelAfterOKSltBin, "", new { @class = "text-danger" })
                }
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @Html.Label("Model UK Vorher")
            </div>
            <div class="col-md-6">
                @Html.Label("Model UK Nachher/Aktuell")
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @if (Model.ModelBeforeUKSltId != 0)
                {
                    <canvas name="jsc3dcv" width=480 height=480 urltoload="@Url.Action("OpenPicture", "Case", new { id = @Model.ModelBeforeUKSltId })">
                        Ihr Browser ist leider nicht in der Lage das Model anzuzeigen.
                    </canvas>
                    <br />
                    if (Model.ModelBeforeUKSltName != null)
                    {
                        @Model.ModelBeforeUKSltName
                    }
                }
                @if (@ViewBag.isAdmin == true)
                {
                    @Html.TextBoxFor(m => m.ModelBeforeUKSltBin, new { type = "file" })
                    @Html.ValidationMessageFor(m => m.ModelBeforeUKSltBin, "", new { @class = "text-danger" })
                }
            </div>
            <div class="col-md-6">
                @if (Model.ModelAfterUKSltId != 0)
                {
                    <canvas name="jsc3dcv" width=480 height=480 urltoload="@Url.Action("OpenPicture", "Case", new { id = @Model.ModelAfterUKSltId })">
                        Ihr Browser ist leider nicht in der Lage das Model anzuzeigen.
                    </canvas>
                    <br />
                    if (Model.ModelAfterUKSltName != null)
                    {
                        @Model.ModelAfterUKSltName
                    }
                }
                @if (@ViewBag.isAdmin == true)
                {
                    @Html.TextBoxFor(m => m.ModelAfterUKSltBin, new { type = "file" })
                    @Html.ValidationMessageFor(m => m.ModelAfterUKSltBin, "", new { @class = "text-danger" })
                }
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/app3d")

</body>
</html>

