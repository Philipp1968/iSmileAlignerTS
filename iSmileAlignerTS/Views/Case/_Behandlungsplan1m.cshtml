@model iSmileAlignerTS.Models.CaseViewModel

<div class="form-group">
    <div class="row">
        <div class="col-md-6">
            @if (@Model.ModelBeforeFrontFotoId != 0 && @Model.ModelBeforeFrontThumbId != 0)
            {
                <a href="@Url.Action("OpenPicture", "Case", new { id = @Model.ModelBeforeFrontFotoId })" target="_blank">
                    <img src="@Url.Action("OpenPicture", "Case", new { id = @Model.ModelBeforeFrontThumbId })" title="@Model.ModelBeforeFrontFotoName" />
                </a>
                <br />
            }
            else
            {
                <img src="~/Images/beforefront.png" title="Model davor" />
            }
            @if (@ViewBag.isAdmin == true)
            {
                @Html.TextBoxFor(m => m.ModelBeforeFrontFotoBin, new { type = "file" })
                @Html.ValidationMessageFor(m => m.ModelBeforeFrontFotoBin, "", new { @class = "text-danger" })
            }
        </div>
