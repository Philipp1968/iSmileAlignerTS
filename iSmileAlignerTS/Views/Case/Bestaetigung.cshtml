@model iSmileAlignerTS.Models.CaseViewModel

@{
    ViewBag.Title = "Fallangaben Bestätigen";
}

<h2>@ViewBag.Title</h2>
<p> &nbsp; </p>

@using (Html.BeginForm("Bestaetigung", "Case", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.CaseId);
    @Html.HiddenFor(m => m.RowVersion);
    @Html.HiddenFor(m => m.CaseNumber);

    @Html.ValidationSummary("", new { @class = "text-danger" })

    if (ViewBag.ValidationErrors != null)
    {
        <div class="form-group">
            <div class="row">
                @Html.Label("Eingabeproblem", new { @class = "col-md-2 control-label" })
                <div class="col-md-8">
                    <p>
                        <b>
                            <font color="red">
                                @ViewBag.ValidationErrors
                            </font>
                        </b>
                    </p>
                </div>
            </div>
        </div>
    }

    <div class="form-group">
        <div class="row">
            @Html.Label("Arzt:", new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.DisplayFor(m => m.DoctorName, new { @class = "form-control" })
            </div>
        </div>
    </div>

    @Html.Partial("_PatientView")

    @Html.Partial("_NachrichtenView")

    <div class="form-group">
        <div class="row">
            @Html.Label("Bestellung:", new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                Ja &nbsp; @Html.RadioButtonFor(m => m.BestelltWieAngegeben, "1", new { style = "width:24px;height:24px" }) &nbsp;
                Bestellt wie angegeben &nbsp; @Html.RadioButtonFor(m => m.BestelltWieAngegeben, "2", new { style = "width:24px;height:24px" })
            </div>
        </div>
    </div>

    <div class="form-group">
        <div class="row">
            @Html.Label("Anmerkung:", new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.BestelltWieAngegebenKommentar, new { @cols = 120, @rows = 4, htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-4">
            <input type="submit" name="submitButton" class="btn btn-primary" value="Speichern" style="background-color: #ca0d89" />
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/app3d")
}


