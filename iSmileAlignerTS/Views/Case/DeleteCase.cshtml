@model iSmileAlignerTS.Models.CaseViewModel

@{
    ViewBag.Title = "Fall LÖSCHEN";
}

<h2>@ViewBag.Title</h2>
<p> &nbsp; </p>

@using (Html.BeginForm("DeleteCase", "Case", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.CaseId);
    @Html.HiddenFor(m => m.RowVersion);

    @Html.ValidationSummary("", new { @class = "text-danger" })

    if (ViewBag.ValidationErrors != null)
    {
        <div class="form-group">
            <div class="row">
                @Html.Label("Eingabeproblem", new { @class = "col-md-2 control-label" })
                <div class="col-md-8">
                    <p>
                        <b>
                            <font color="red">
                                @ViewBag.ValidationErrors
                            </font>
                        </b>
                    </p>
                </div>
            </div>
        </div>
    }

    <div class="form-group">
        <div class="row">
            @Html.Label("Arzt:", new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.DisplayFor(m => m.DoctorName, new { @class = "form-control" })
            </div>
        </div>
    </div>

    <hr />

    @Html.Partial("_Patient")

    @Html.Partial("_Oberkiefer")

    @Html.Partial("_Unterkiefer")

    @Html.Partial("_Zusatzbehandlungen")

    <hr />

    <div class="form-group">
        @Html.Label("Löschen:", new { @class = "col-md-2 control-label" })
        <div class="col-md-4">
            @Html.TextBoxFor(m => m.DeleteWord, new { placeholder = "LÖSCHEN bitte eintippen" })
        </div>
    </div>

    <hr />

    <div class="form-group">
        <div class="col-md-offset-2 col-md-4">
            <input type="submit" name="submitButton" class="btn btn-default" value="!!! LÖSCHEN !!!" />
        </div>
    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}